# Database Configuration (SQLite for zero-setup local dev, PostgreSQL for Neon production)
DATABASE_URL="file:./dev.db"

# Hackathon Demo Mode (Set to true to use deterministic visual simulation without requiring API key)
DEMO_MODE="false"

# 1. NVIDIA Vision Provider (Primary)
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.2-90b-vision-instruct"

# 2. Groq Vision Provider (Secondary Fallback)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# 3. Google Gemini Vision Provider (Tertiary Fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Cloudflare R2 Object Storage (Optional free tier, local storage fallback used when empty)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
